# DATABASE
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=surveillance_os
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here
DATABASE_URL="postgresql://postgres:your_strong_password_here@localhost:5432/surveillance_os"

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# JWT SECRETS
JWT_ACCESS_SECRET=replace_with_random_64_char_string
JWT_REFRESH_SECRET=replace_with_different_random_64_char_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MINIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=surveillance-recordings

# SERVICES
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
AI_SERVICE_URL=http://localhost:8000

# MEDIAMTX
MEDIAMTX_API_URL=http://localhost:9997
HLS_BASE_URL=http://localhost:8888
