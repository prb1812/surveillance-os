generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  SUPER_ADMIN
  OPERATOR
  CUSTOMER
}

enum CameraStatus {
  ONLINE
  OFFLINE
  RECORDING
  ERROR
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum AlertType {
  PERSON_DETECTED
  VEHICLE_DETECTED
  ZONE_INTRUSION
  CAMERA_OFFLINE
  CAMERA_ONLINE
  PLATE_FLAGGED
  MOTION_DETECTED
}

enum Plan {
  BASIC
  STANDARD
  PREMIUM
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          Role
  isActive      Boolean   @default(true)
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client        Client?   @relation(fields: [clientId], references: [id])
  clientId      String?

  operatorShifts      Shift[]
  auditLogs           AuditLog[]
  acknowledgedAlerts  Alert[]  @relation("AcknowledgedBy")
  resolvedAlerts      Alert[]  @relation("ResolvedBy")
  assignedCameras     CameraAssignment[]
  refreshTokens       RefreshToken[]

  @@index([email])
  @@index([clientId])
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  address   String?
  plan      Plan     @default(BASIC)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  cameras  Camera[]
  alerts   Alert[]
  anprLogs ANPRLog[]
}

model Camera {
  id        String       @id @default(cuid())
  name      String
  location  String?
  rtspUrl   String
  hlsPath   String?
  status    CameraStatus @default(OFFLINE)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  client    Client @relation(fields: [clientId], references: [id])
  clientId  String

  alerts      Alert[]
  recordings  Recording[]
  anprLogs    ANPRLog[]
  assignments CameraAssignment[]

  @@index([clientId])
}

model CameraAssignment {
  id         String   @id @default(cuid())
  camera     Camera   @relation(fields: [cameraId], references: [id])
  cameraId   String
  operator   User     @relation(fields: [operatorId], references: [id])
  operatorId String
  assignedAt DateTime @default(now())

  @@unique([cameraId, operatorId])
}

model Alert {
  id          String        @id @default(cuid())
  type        AlertType
  severity    AlertSeverity @default(MEDIUM)
  status      AlertStatus   @default(OPEN)
  message     String
  snapshotUrl String?
  metadata    Json?
  notes       String?

  camera   Camera @relation(fields: [cameraId], references: [id])
  cameraId String

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  acknowledgedBy   User?     @relation("AcknowledgedBy", fields: [acknowledgedById], references: [id])
  acknowledgedById String?
  acknowledgedAt   DateTime?

  resolvedBy   User?     @relation("ResolvedBy", fields: [resolvedById], references: [id])
  resolvedById String?
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([cameraId])
  @@index([createdAt])
  @@index([status])
}

model Recording {
  id         String    @id @default(cuid())
  camera     Camera    @relation(fields: [cameraId], references: [id])
  cameraId   String
  startTime  DateTime
  endTime    DateTime?
  duration   Int?
  storageKey String
  fileSize   Int?
  createdAt  DateTime  @default(now())

  @@index([cameraId])
  @@index([startTime])
}

model ANPRLog {
  id           String   @id @default(cuid())
  plateNumber  String
  confidence   Float?
  snapshotUrl  String?
  isFlagged    Boolean  @default(false)
  isAuthorized Boolean  @default(false)
  notes        String?

  camera   Camera @relation(fields: [cameraId], references: [id])
  cameraId String

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  detectedAt DateTime @default(now())

  @@index([plateNumber])
  @@index([clientId])
  @@index([detectedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  resource   String?
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Shift {
  id         String    @id @default(cuid())
  operator   User      @relation(fields: [operatorId], references: [id])
  operatorId String
  startTime  DateTime
  endTime    DateTime?
  isActive   Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([operatorId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}